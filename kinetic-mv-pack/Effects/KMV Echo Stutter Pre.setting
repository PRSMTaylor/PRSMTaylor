{
	Tools = ordered() {
		KMV_Echo_Stutter_Pre = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Src", Source = "Input", },
				Length = InstanceInput { SourceOp = "Ctl", Source = "Length", Default = 12, },
				Intensity = InstanceInput { SourceOp = "Ctl", Source = "Intensity", Default = 1.0, },
				Offset = InstanceInput { SourceOp = "Ctl", Source = "Offset", Default = 2, },
				Echo = InstanceInput { SourceOp = "Ctl", Source = "Echo", Default = 0.6, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Fx", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Src = Transform {
					CtrlWZoom = false,
					Inputs = {
						Size = Input { Value = 1.0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				Echo1 = TimeStretcher {
					CtrlWZoom = false,
					Inputs = {
						Input = Input { SourceOp = "Src", Source = "Output", },
						SourceTime = Input { Expression = "time-Ctl.Active*1*Ctl.Offset", },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Echo2 = TimeStretcher {
					CtrlWZoom = false,
					Inputs = {
						Input = Input { SourceOp = "Src", Source = "Output", },
						SourceTime = Input { Expression = "time-Ctl.Active*2*Ctl.Offset", },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				Echo3 = TimeStretcher {
					CtrlWZoom = false,
					Inputs = {
						Input = Input { SourceOp = "Src", Source = "Output", },
						SourceTime = Input { Expression = "time-Ctl.Active*3*Ctl.Offset", },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 } },
				},
				Mix1 = Merge {
					CtrlWZoom = false,
					Inputs = {
						Background = Input { SourceOp = "Src", Source = "Output", },
						Foreground = Input { SourceOp = "Echo1", Source = "Output", },
						Blend = Input { Expression = "Ctl.Env*Ctl.Echo^1", },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
				},
				Mix2 = Merge {
					CtrlWZoom = false,
					Inputs = {
						Background = Input { SourceOp = "Mix1", Source = "Output", },
						Foreground = Input { SourceOp = "Echo2", Source = "Output", },
						Blend = Input { Expression = "Ctl.Env*Ctl.Echo^2", },
					},
					ViewInfo = OperatorInfo { Pos = { 550, 0 } },
				},
				Fx = Merge {
					CtrlWZoom = false,
					Inputs = {
						Background = Input { SourceOp = "Mix2", Source = "Output", },
						Foreground = Input { SourceOp = "Echo3", Source = "Output", },
						Blend = Input { Expression = "Ctl.Env*Ctl.Echo^3", },
					},
					ViewInfo = OperatorInfo { Pos = { 660, 0 } },
				},
				Ctl = Background {
					CtrlWZoom = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						Active = Input { Expression = "iif((comp.RenderEnd-time) < self.Length, 1, 0)", },
						Env = Input { Expression = "iif((comp.RenderEnd-time) < self.Length, self.Intensity, 0)", },
						Length = Input { Value = 12, },
						Intensity = Input { Value = 1.0, },
						Offset = Input { Value = 2, },
						Echo = Input { Value = 0.6, },
					},
				UserControls = ordered() {
					Length = { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 12, INP_MinScale = 1, INP_MaxScale = 120, INP_Integer = true, LINKS_Name = "Length (frames)", ICS_ControlPage = "Controls" },
					Intensity = { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 1.0, INP_MinScale = 0.0, INP_MaxScale = 2.0, INP_Integer = false, LINKS_Name = "Intensity", ICS_ControlPage = "Controls" },
					Offset = { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 2, INP_MinScale = 1, INP_MaxScale = 24, INP_Integer = true, LINKS_Name = "Echo Spacing (frames)", ICS_ControlPage = "Controls" },
					Echo = { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0.6, INP_MinScale = 0.0, INP_MaxScale = 1.0, INP_Integer = false, LINKS_Name = "Echo Strength", ICS_ControlPage = "Controls" },
					Active = { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 2, INP_Integer = false, LINKS_Name = "Active", ICS_ControlPage = "Controls", IC_Visible = false },
					Env = { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 2, INP_Integer = false, LINKS_Name = "Env", ICS_ControlPage = "Controls", IC_Visible = false },
				},
					ViewInfo = OperatorInfo { Pos = { 770, 0 } },
				},
			},
		},
	},
	ActiveTool = "KMV_Echo_Stutter_Pre"
}
