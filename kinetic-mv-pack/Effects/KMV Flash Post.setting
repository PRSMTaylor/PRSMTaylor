{
	Tools = ordered() {
		KMV_Flash_Post = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Src", Source = "Input", },
				Length = InstanceInput { SourceOp = "Ctl", Source = "Length", Default = 4, },
				Intensity = InstanceInput { SourceOp = "Ctl", Source = "Intensity", Default = 1.0, },
				Strength = InstanceInput { SourceOp = "Ctl", Source = "Strength", Default = 1.0, },
				Curve = InstanceInput { SourceOp = "Ctl", Source = "Curve", Default = 1, },
				Seed = InstanceInput { SourceOp = "Ctl", Source = "Seed", Default = 1, },
				MotionBlur = InstanceInput { SourceOp = "Ctl", Source = "MotionBlur", Default = 0.0, },
				Brightness = InstanceInput { SourceOp = "Ctl", Source = "Brightness", Default = 0.0, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "MB", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Src = Transform {
					CtrlWZoom = false,
					Inputs = {
						Size = Input { Value = 1.0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				Col = Background {
					CtrlWZoom = false,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1.0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Fx = Merge {
					CtrlWZoom = false,
					Inputs = {
						Background = Input { SourceOp = "Src", Source = "Output", },
						Foreground = Input { SourceOp = "Col", Source = "Output", },
						Blend = Input { Expression = "Ctl.Env", },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				Bri = BrightnessContrast {
					CtrlWZoom = false,
					Inputs = {
						Input = Input { SourceOp = "Fx", Source = "Output", },
						Gain = Input { Expression = "1+Ctl.Brightness*Ctl.Active", },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 } },
				},
				MB = DirectionalBlur {
					CtrlWZoom = false,
					Inputs = {
						Input = Input { SourceOp = "Bri", Source = "Output", },
						Type = Input { Value = 0, },
						Length = Input { Expression = "Ctl.MotionBlur*Ctl.Env*0.1", },
						Angle = Input { Value = 0.0, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
				},
				Ctl = Background {
					CtrlWZoom = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						Active = Input { Expression = "iif((time-comp.RenderStart) < self.Length, 1, 0)", },
						Env = Input { Expression = "iif((time-comp.RenderStart) < self.Length, self.Intensity*self.Strength*iif(self.Curve==1, (1-(time-comp.RenderStart)/self.Length)^4, iif(self.Curve==2, (1-(time-comp.RenderStart)/self.Length)*(1-(time-comp.RenderStart)/self.Length)*(3-2*(1-(time-comp.RenderStart)/self.Length)), iif(self.Curve==3, (1-(time-comp.RenderStart)/self.Length), (1-(time-comp.RenderStart)/self.Length)^2))), 0)", },
						Length = Input { Value = 4, },
						Intensity = Input { Value = 1.0, },
						Strength = Input { Value = 1.0, },
						Curve = Input { Value = 1, },
						Seed = Input { Value = 1, },
						MotionBlur = Input { Value = 0.0, },
						Brightness = Input { Value = 0.0, },
					},
				UserControls = ordered() {
					Length = { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 4, INP_MinScale = 1, INP_MaxScale = 30, INP_Integer = true, LINKS_Name = "Length (frames)", ICS_ControlPage = "Controls" },
					Intensity = { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 1.0, INP_MinScale = 0.0, INP_MaxScale = 2.0, INP_Integer = false, LINKS_Name = "Intensity", ICS_ControlPage = "Controls" },
					Strength = { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 1.0, INP_MinScale = 0.0, INP_MaxScale = 3.0, INP_Integer = false, LINKS_Name = "Strength", ICS_ControlPage = "Controls" },
					Curve = { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 1, INP_MinScale = 0, INP_MaxScale = 3, INP_Integer = true, LINKS_Name = "Curve (0 Smooth, 1 Sharp, 2 S, 3 Linear)", ICS_ControlPage = "Controls" },
					Seed = { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 1, INP_MinScale = 0, INP_MaxScale = 999, INP_Integer = true, LINKS_Name = "Random Seed (0 = fixed)", ICS_ControlPage = "Controls" },
					MotionBlur = { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0.0, INP_MinScale = 0.0, INP_MaxScale = 2.0, INP_Integer = false, LINKS_Name = "Motion Blur", ICS_ControlPage = "Controls" },
					Brightness = { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0.0, INP_MinScale = -1.0, INP_MaxScale = 2.0, INP_Integer = false, LINKS_Name = "Brightness", ICS_ControlPage = "Controls" },
					Active = { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 2, INP_Integer = false, LINKS_Name = "Active", ICS_ControlPage = "Controls", IC_Visible = false },
					Env = { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 2, INP_Integer = false, LINKS_Name = "Env", ICS_ControlPage = "Controls", IC_Visible = false },
				},
					ViewInfo = OperatorInfo { Pos = { 550, 0 } },
				},
			},
		},
	},
	ActiveTool = "KMV_Flash_Post"
}
